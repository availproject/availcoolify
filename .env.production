# is /var/www/html/storage/app/ssh/db-ca.pem in the container.
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/var/www/html/storage/app/ssh/db-ca.pem

