APP_ID=
APP_NAME=Coolify
APP_KEY=

DB_USERNAME=coolify
DB_PASSWORD=
# Remote (managed) Postgres: one URL with the TLS mode in it (percent-encode special characters in
# the password). The release pipeline writes this from the SSM parameter DATABASE_URL.
# DATABASE_URL=postgres://coolify:PASSWORD@HOST:5432/coolify?sslmode=require
# sslmode=verify-full also needs the provider's CA file inside the container, e.g.
# /data/coolify/ssh/db-ca.pem on the host is /var/www/html/storage/app/ssh/db-ca.pem in the container:
# DB_SSLROOTCERT=/var/www/html/storage/app/ssh/db-ca.pem
# Older style, still read: DB_HOST, DB_PORT, DB_SSLMODE.

REDIS_PASSWORD=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

REGISTRY_URL=docker.io

# Laravel logs to stderr, so they reach `docker logs` and the log shipper (SigNoz) instead of a file
# inside the container.
LOG_CHANNEL=stderr
LOG_LEVEL=info
